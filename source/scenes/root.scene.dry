title: Root Scene
new-page: true
go-to: post_event if started = 1; start_menu if started = 0

@start_menu
new-page: true
go-to: start_menu_2
on-arrival: {!
window.enableFocusMode()
!}

= Social Democracy: An Alternate Horizon <br>      

@start_menu_2

<div style="width: 100%; height: 300px; background-image: url('img/root.jpg'); background-size: cover; background-position: center;"></div>

- @start: Start game
- @mod_info: Mod Information
- @game_over.achievements

@start
on-arrival: {!
// time elapsed (in months)
Q.time = 0;
Q.year = 1927;
Q.month = 10;
Q.weeks = 2;
// how many actions have been taken this month?
Q.month_actions = 1;
if (!Q.rng_seed) {
    Q.rng_seed = Date.now() & 0xFFFFFFFF;
}
Q.commercialized_media = Q.commercialized_media || 0;
Q.cultural_organizations = Q.cultural_organizations || 0;
Q.agricultural_assist = Q.agricultural_assist || 0;
Q.radio = Q.radio || 0;
Q.landvolk_suppress = Q.landvolk_suppress || 0;
Q.workers_aid = Q.workers_aid || 0;


    if (!Q.dues_workers) { Q.dues_workers = 1; }
    if (!Q.dues_unemployedc) { Q.dues_unemployedc = 0.5; }
    if (!Q.dues_new_middle) { Q.dues_new_middle = 2; }
    if (!Q.dues_old_middle) { Q.dues_old_middle = 1; }
    if (!Q.dues_rural) { Q.dues_rural = 1; }



Q.player_party = "SPD";
Q.z_name = "Z";
Q.dnvp_name = "DNVP";
Q.country_name = "Weimar Republic";
Q.prussian_republicanization = 50;
Q.dnvp_referendum = 0;
Q.stahlhelm_status = 0;
Q.presidential_patience = 50;
// whether or not the president can dismiss the government via presidential_patience reaching 0.
Q.presidential_enabled = 0;
// Does the SPD lead in Prusssia?
Q.spd_prussia = 1;
// Options: spd, z, dnvp, papen, nsdap
Q.prussian_government = "SPD";

Q.business_wing_ddp = 370;
Q.social_republican_ddp = 130;
Q.z_clerical_power = 250;
Q.z_left_labor_power = 250;
Q.z_right_labor_power = 200;
Q.z_moderate_power = 300;
Q.dvp_left = 550;
Q.dvp_right = 450;
Q.hugenberg_momentum = 20;
Q.delegate_power_nat_cons = 600;
Q.delegate_power_agrarians = 120;
Q.delegate_power_moderates = 200;
Q.delegate_power_yocon = 20;
Q.delegate_power_christsoc = 50;
Q.spd_in_government_prussia = 1;
Q.z_in_government_prussia = 1;
Q.ddp_in_government_prussia = 1;
Q.coalition_name_prussia = "Weimar Coalition";
Q.coalition_name = "Bürgerblock";

Q.copy_parties = [
    'kpd', 'spd', 'kpo', 'sl', 'sapd', 'srpd', 'ddp', 'z', 'bvp', 'csrp', 'dvp', 'wp',
    'cnbl', 'csvd', 'dnvp', 'vrp', 'kvp', 'dhp', 'bb', 'dvfp', 'nsdap',
    'aspd', 'vnr', 'hl', 'lb', 'rdp', 'cvp', 'sls', 'dtsp', 'dbp', 'dsbp', 'dnf', 'rlb', 'faud', 'kapd', 'uspd', 'pp', 'gsrn', 'a'
];

for (const party of Q.copy_parties) {
    var govKey = party + '_in_government';
    var govPrussiaKey = party + '_in_government_prussia';

    if (Q[govKey] === undefined) {
        Q[govKey] = 0;
    }
    if (Q[govPrussiaKey] === undefined) {
        Q[govPrussiaKey] = 0;
    }
}
